        <!-- 边界状态分支 -->
        <mxCell id="5" value="是（边界模糊）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6" value="启动观察期 T_observe (如10分钟) &lt;br&gt; 维持原区域输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- 观察期内记录 -->
        <mxCell id="7" value="持续接收核心引擎判定 &lt;br&gt; 记录区域编码" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="360" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- 稳定性判决 -->
        <mxCell id="8" value="观察期结束，分析记录：&lt;br&gt; 某区域占比 &gt; 90% ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="120" y="460" width="160" height="80" as="geometry" />
        </mxCell>
        <!-- 确认切换 -->
        <mxCell id="9" value="是，切换到新区域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- 维持原区域 -->
        <mxCell id="10" value="否，维持原区域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="120" y="580" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- 连接线 -->
        <mxCell id="11" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
