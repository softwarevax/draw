        <mxCell id="1" parent="0" />
        <!-- 输入 -->
        <mxCell id="2" value="传感器 t, φ" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;" vertex="1" parent="1">
