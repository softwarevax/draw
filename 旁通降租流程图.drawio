  <diagram name="2. 边界状态滞回处理逻辑" id="iHuVfq4T0d6JuMHCoNEl">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 开始 -->
        <mxCell id="2" value="接收实时d,h,t" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- 边界识别 -->
        <mxCell id="3" value="是否 |d-d1|&lt;ε_d 或 |h-h1|&lt;ε_h 或 |t-t1|&lt;ε_t ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="120" y="140" width="120" height="80" as="geometry" />
        </mxCell>
        <!-- 正常处理 -->
        <mxCell id="4" value="直接输出区域判定结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="140" height="60" as="geometry" />
