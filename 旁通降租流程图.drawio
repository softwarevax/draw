        <!-- 整体框架 swimlanes 表示三大处理流 -->
        <mxCell id="2" value="实时数据流" style="swimlane;whiteSpace=wrap;html=1;startSize=30;horizontal=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="300" height="600" as="geometry" />
