  <diagram name="9. 核心控制引擎图 (原image5)" id="IcvvSFEoyduns9ox7rDS">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 输入 -->
        <mxCell id="2" value="温湿度传感器 (t, φ)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="气压 p (预设/实测)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- 处理 -->
        <mxCell id="4" value="低通滤波" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="5" value="计算 p_b, p_q" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="120" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="6" value="计算 d, h" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7" value="区域判定逻辑" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="140" height="80" as="geometry" />
        </mxCell>
        <!-- 条件说明 -->
        <mxCell id="8" value="d≥d1 → I&lt;br&gt;d&lt;d1且h≥h1 → II&lt;br&gt;h3≤h&lt;h1且t≥t1 → III&lt;br&gt;否则 IV" style="text;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="160" height="80" as="geometry" />
